+                    mm(m4,  ggml_ciot_slot1(v0), ggml_ciot_slot1(v1), 1);
+                    mm(m16, ggml_ciot_slot2(v0), ggml_ciot_slot2(v1), 2);
+                    mm(m1,  ggml_ciot_slot3(v0), ggml_ciot_slot3(v1), 3);
