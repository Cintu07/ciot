+#ifdef GGML_CIOT_T2
+template <> int repack<block_pq2_0, 16, 4>(struct ggml_tensor * t, const void * data, size_t data_size) {
+    return repack_pq2_0_to_t2x4(t, data, data_size);
+}
+#endif
