diff --git a/examples/ciot-spec/ciot-spec.cpp b/examples/ciot-spec/ciot-spec.cpp
new file mode 100644
index 0000000..eb70e95
--- /dev/null
+++ b/examples/ciot-spec/ciot-spec.cpp
@@ -0,0 +1,315 @@
+// Greedy prompt-lookup speculative decoding for hybrid (recurrent + attention) models on CPU.
+//
+// Each step proposes up to k draft tokens by finding the most recent earlier occurrence of the
+// last g tokens in the context, verifies [next, draft...] in one llama_decode, keeps the matching
+// prefix, and rolls the recurrent state back with llama_memory_seq_rm, which restores a snapshot
+// from the n_rs_seq ring. Greedy speculation must reproduce plain greedy decoding, so the program
+// runs both and compares the token streams.
+//
+// usage: llama-ciot-spec -m model.gguf -f prompt.txt [-n 256] [-k 3] [-g 3] [-t 8]
+#include "llama.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+static llama_token argmax(const float * logits, int n_vocab, float * margin = nullptr) {
+    llama_token best = 0;
+    for (int i = 1; i < n_vocab; i++) {
+        if (logits[i] > logits[best]) {
+            best = i;
+        }
+    }
+    if (margin) {
+        float second = -1e30f;
+        for (int i = 0; i < n_vocab; i++) {
+            if (i != best && logits[i] > second) {
+                second = logits[i];
+            }
+        }
+        *margin = logits[best] - second;
+    }
+    return best;
+}
+
+// Tokens that followed the most recent earlier occurrence of the context's last g tokens.
+// Falls back to shorter n-grams down to 2.
+static void lookup_draft(const std::vector<llama_token> & toks, int g_max, int k, std::vector<llama_token> & draft) {
+    draft.clear();
+    const int L = (int) toks.size();
+    for (int g = g_max; g >= 2 && draft.empty(); --g) {
+        if (L < g + 1) {
+            continue;
+        }
+        for (int i = L - g - 1; i >= 0; --i) {
+            if (std::memcmp(&toks[i], &toks[L - g], g * sizeof(llama_token)) == 0) {
+                for (int j = i + g; j < L && (int) draft.size() < k; ++j) {
+                    draft.push_back(toks[j]);
+                }
+                break;
+            }
+        }
+    }
+}
+
+struct run_stats {
+    std::vector<llama_token> out;
+    std::vector<float>       margin; // top1 - top2 logit gap behind each output token
+    std::vector<int>         n_batch_of; // size of the decode batch that produced each token's logits
+    double decode_s    = 0;
+    int    n_steps     = 0;
+    int    n_drafted   = 0;
+    int    n_accepted  = 0;
+};
+
+// Draft sources. ORACLE drafts the reference greedy continuation, so any rejection is batched
+// verification computing a different argmax than one-token decode (numerics, not rollback).
+// JUNK drafts tokens guaranteed to differ from the reference, so every step rolls back; the
+// output must still equal the reference if rollback restores the right state.
+enum draft_mode { DRAFT_LOOKUP, DRAFT_ORACLE, DRAFT_JUNK };
+
+static bool adaptive = true; // --no-adaptive drafts on every step
+
+static bool run(llama_model * model, const std::vector<llama_token> & prompt, int n_predict, int k, int g, int n_threads, run_stats & st,
+                draft_mode mode = DRAFT_LOOKUP, const std::vector<llama_token> * ref = nullptr) {
+    const llama_vocab * vocab   = llama_model_get_vocab(model);
+    const int           n_vocab = llama_vocab_n_tokens(vocab);
+
+    llama_context_params cparams = llama_context_default_params();
+    cparams.n_ctx           = (uint32_t) (prompt.size() + n_predict + k + 16);
+    cparams.n_batch         = 512;
+    cparams.n_ubatch        = 512;
+    cparams.n_threads       = n_threads;
+    cparams.n_threads_batch = n_threads;
+    cparams.n_rs_seq        = k > 0 ? (uint32_t) (k + 1) : 0; // plain greedy keeps the stock (ring-free) path
+    llama_context * ctx = llama_init_from_model(model, cparams);
+    if (!ctx) {
+        fprintf(stderr, "failed to create context\n");
+        return false;
+    }
+    llama_memory_t mem = llama_get_memory(ctx);
+
+    llama_batch pb = llama_batch_get_one(const_cast<llama_token *>(prompt.data()), (int32_t) prompt.size());
+    if (llama_decode(ctx, pb)) {
+        fprintf(stderr, "prompt decode failed\n");
+        return false;
+    }
+
+    std::vector<llama_token> toks = prompt;
+    std::vector<llama_token> draft;
+    llama_batch batch = llama_batch_init(k + 1, 0, 1);
+    int         n_past = (int) prompt.size();
+    float       next_margin = 0;
+    int         next_batch  = (int) prompt.size();
+    llama_token next   = argmax(llama_get_logits_ith(ctx, -1), n_vocab, &next_margin);
+
+    // Adaptive drafting: a verify batch costs more than a single-token step, so when recent
+    // drafts keep getting rejected (free-form prose), stop drafting for a while, then probe again.
+    float accept_ema = 1.0f;
+    int   cooldown   = 0;
+    int   backoff    = 8; // doubles every time drafting fails again, resets when a probe pays off
+
+    const auto t0 = std::chrono::steady_clock::now();
+    while ((int) st.out.size() < n_predict) {
+        if (llama_vocab_is_eog(vocab, next)) {
+            break;
+        }
+        st.out.push_back(next);
+        st.margin.push_back(next_margin);
+        st.n_batch_of.push_back(next_batch);
+        toks.push_back(next);
+        if ((int) st.out.size() >= n_predict) {
+            break;
+        }
+
+        const int k_now = std::min(k, n_predict - (int) st.out.size());
+        draft.clear();
+        if (k > 0 && mode == DRAFT_LOOKUP) {
+            if (adaptive && cooldown > 0) {
+                cooldown--;
+            } else {
+                lookup_draft(toks, g, k_now, draft);
+            }
+        } else if (k > 0 && ref) {
+            for (int i = 0; i < k_now && st.out.size() + i < ref->size(); ++i) {
+                const llama_token r = (*ref)[st.out.size() + i];
+                draft.push_back(mode == DRAFT_ORACLE ? r : (r + 1) % n_vocab);
+            }
+        }
+
+        batch.n_tokens = 1 + (int32_t) draft.size();
+        for (int i = 0; i < batch.n_tokens; ++i) {
+            batch.token[i]     = i == 0 ? next : draft[i - 1];
+            batch.pos[i]       = n_past + i;
+            batch.n_seq_id[i]  = 1;
+            batch.seq_id[i][0] = 0;
+            batch.logits[i]    = true;
+        }
+        if (llama_decode(ctx, batch)) {
+            fprintf(stderr, "decode failed at pos %d\n", n_past);
+            return false;
+        }
+        st.n_steps++;
+        st.n_drafted += (int) draft.size();
+
+        int         a    = 0;
+        float       m    = 0;
+        llama_token pred = argmax(llama_get_logits_ith(ctx, 0), n_vocab, &m);
+        while (a < (int) draft.size() && pred == draft[a] && !llama_vocab_is_eog(vocab, pred) && (int) st.out.size() < n_predict) {
+            st.out.push_back(draft[a]);
+            st.margin.push_back(m);
+            st.n_batch_of.push_back(batch.n_tokens);
+            toks.push_back(draft[a]);
+            ++a;
+            pred = argmax(llama_get_logits_ith(ctx, a), n_vocab, &m);
+        }
+        next_margin = m;
+        next_batch  = batch.n_tokens;
+        st.n_accepted += a;
+        if (!draft.empty()) {
+            const float rate = (float) a / (float) draft.size();
+            accept_ema = 0.7f * accept_ema + 0.3f * rate;
+            if (accept_ema < 0.3f) {
+                cooldown   = backoff;                 // skip drafting for a while
+                backoff    = std::min(backoff * 2, 64);
+                accept_ema = 0.5f;                    // then probe from a neutral estimate
+            } else if (rate >= 0.5f) {
+                backoff = 8;
+            }
+        }
+        n_past += 1 + a;
+
+        if (a < (int) draft.size() && !llama_memory_seq_rm(mem, 0, n_past, -1)) {
+            fprintf(stderr, "rollback refused at pos %d (n_rs_seq=%u)\n", n_past, llama_n_rs_seq(ctx));
+            return false;
+        }
+        next = pred;
+    }
+    st.decode_s = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+
+    llama_batch_free(batch);
+    llama_free(ctx);
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    std::string model_path, prompt_path, prompt = "def fib(n):";
+    int n_predict = 256, k = 3, g = 3, n_threads = 8;
+    bool check = false; // also run oracle and junk drafts
+    for (int i = 1; i < argc; i++) {
+        if (!strcmp(argv[i], "-m") && i + 1 < argc)      model_path  = argv[++i];
+        else if (!strcmp(argv[i], "-f") && i + 1 < argc) prompt_path = argv[++i];
+        else if (!strcmp(argv[i], "-p") && i + 1 < argc) prompt      = argv[++i];
+        else if (!strcmp(argv[i], "-n") && i + 1 < argc) n_predict   = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "-k") && i + 1 < argc) k           = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "-g") && i + 1 < argc) g           = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "-t") && i + 1 < argc) n_threads   = atoi(argv[++i]);
+        else if (!strcmp(argv[i], "--check"))            check       = true;
+        else if (!strcmp(argv[i], "--no-adaptive"))      adaptive    = false;
+    }
+    if (model_path.empty()) {
+        fprintf(stderr, "usage: %s -m model.gguf [-f prompt.txt | -p text] [-n 256] [-k 3] [-g 3] [-t 8]\n", argv[0]);
+        return 1;
+    }
+    if (!prompt_path.empty()) {
+        std::ifstream f(prompt_path, std::ios::binary);
+        std::stringstream ss;
+        ss << f.rdbuf();
+        prompt = ss.str();
+    }
+
+    setvbuf(stdout, nullptr, _IONBF, 0); // results survive even if teardown crashes
+
+#if defined(_WIN32)
+    // Same effect as llama-bench --prio 2: keeps Windows from preempting spinning workers.
+    SetPriorityClass(GetCurrentProcess(), HIGH_PRIORITY_CLASS);
+#endif
+
+    llama_backend_init();
+    llama_model_params mparams = llama_model_default_params();
+    mparams.load_mode          = LLAMA_LOAD_MODE_NONE; // read into RAM; mmap pages get evicted next to the repacked copy
+    llama_model * model        = llama_model_load_from_file(model_path.c_str(), mparams);
+    if (!model) {
+        fprintf(stderr, "failed to load model\n");
+        return 1;
+    }
+    const llama_vocab * vocab = llama_model_get_vocab(model);
+
+    const int n_prompt = -llama_tokenize(vocab, prompt.c_str(), (int32_t) prompt.size(), NULL, 0, true, true);
+    std::vector<llama_token> ptoks(n_prompt);
+    llama_tokenize(vocab, prompt.c_str(), (int32_t) prompt.size(), ptoks.data(), n_prompt, true, true);
+    if (n_prompt > 500) {
+        fprintf(stderr, "prompt is %d tokens, keep it under 500 so it fits one micro-batch\n", n_prompt);
+        return 1;
+    }
+
+    run_stats base, spec;
+    if (!run(model, ptoks, n_predict, 0, g, n_threads, base)) {
+        return 1;
+    }
+    if (check) {
+        for (draft_mode m : {DRAFT_ORACLE, DRAFT_JUNK}) {
+            run_stats st;
+            if (!run(model, ptoks, n_predict, k, g, n_threads, st, m, &base.out)) {
+                return 1;
+            }
+            int first = -1;
+            for (size_t i = 0; i < base.out.size() && i < st.out.size(); ++i) {
+                if (base.out[i] != st.out[i]) { first = (int) i; break; }
+            }
+            printf("check %-6s : %d/%d drafts accepted, first mismatch vs greedy: %s\n", m == DRAFT_ORACLE ? "oracle" : "junk",
+                   st.n_accepted, st.n_drafted, first < 0 ? "none" : std::to_string(first).c_str());
+        }
+    }
+    if (!run(model, ptoks, n_predict, k, g, n_threads, spec)) {
+        return 1;
+    }
+
+    size_t mismatch = 0;
+    int    first    = -1;
+    for (size_t i = 0; i < base.out.size() && i < spec.out.size(); ++i) {
+        if (base.out[i] != spec.out[i]) {
+            mismatch++;
+            if (first < 0) first = (int) i;
+        }
+    }
+
+    std::string text;
+    for (llama_token t : spec.out) {
+        char buf[256];
+        const int n = llama_token_to_piece(vocab, t, buf, sizeof(buf), 0, true);
+        if (n > 0) text.append(buf, n);
+    }
+
+    printf("\n--- output (speculative) ---\n%s\n---\n", text.c_str());
+    printf("prompt tokens     : %d\n", n_prompt);
+    printf("greedy            : %zu tokens in %.2f s = %.2f tok/s\n", base.out.size(), base.decode_s, base.out.size() / base.decode_s);
+    printf("speculative (k=%d) : %zu tokens in %.2f s = %.2f tok/s, %d verify steps, %d/%d drafts accepted (%.0f%%)\n",
+           k, spec.out.size(), spec.decode_s, spec.out.size() / spec.decode_s, spec.n_steps, spec.n_accepted, spec.n_drafted,
+           spec.n_drafted ? 100.0 * spec.n_accepted / spec.n_drafted : 0.0);
+    printf("speedup           : %.2fx\n", base.decode_s / spec.decode_s);
+    printf("token mismatches  : %zu%s\n", mismatch, first >= 0 ? (" (first at " + std::to_string(first) + ")").c_str() : "");
+    if (first >= 0) {
+        printf("at first mismatch : greedy picked %d (margin %.4f, %d-token batch), speculative picked %d (margin %.4f, %d-token batch)\n",
+               base.out[first], base.margin[first], base.n_batch_of[first], spec.out[first], spec.margin[first], spec.n_batch_of[first]);
+        float min_margin = 1e30f;
+        for (int i = 0; i < first; ++i) {
+            min_margin = std::min(min_margin, base.margin[i]);
+        }
+        printf("smallest greedy margin before it : %.4f\n", min_margin);
+    }
+
+    llama_model_free(model);
+    llama_backend_free();
+    return 0;
+}
diff --git a/ggml/src/ggml-cpu/arch-fallback.h b/ggml/src/ggml-cpu/arch-fallback.h
index f22018a..c248cc2 100644
--- a/ggml/src/ggml-cpu/arch-fallback.h
+++ b/ggml/src/ggml-cpu/arch-fallback.h
@@ -82,10 +82,12 @@
 #define ggml_gemm_q1_0_4x8_q8_0_generic ggml_gemm_q1_0_4x8_q8_0
 #define ggml_gemm_pq2_0_4x8_q8_0_generic ggml_gemm_pq2_0_4x8_q8_0
 #elif defined(__aarch64__) || defined(__arm__) || defined(_M_ARM) || defined(_M_ARM64)
-// PTQ1_0's NEON vec_dot is unverified on real ARM hardware and measured slower
-// than the generic loop on two independent devices (Apple M5 Pro, Snapdragon 7
-// Gen 4); alias it back to generic until a validated replacement lands
+// PTQ1_0's earlier NEON vec_dot measured slower than the generic loop on two devices
+// (Apple M5 Pro, Snapdragon 7 Gen 4). AArch64 with dotprod now uses the CIOT kernel in
+// arch/arm/quants.c; anything else keeps the generic loop.
+#if !defined(__aarch64__) || !defined(__ARM_FEATURE_DOTPROD)
 #define ggml_vec_dot_ptq1_0_q8_0_generic ggml_vec_dot_ptq1_0_q8_0
+#endif
 // repack.cpp
 #define ggml_quantize_mat_q8_K_4x4_generic ggml_quantize_mat_q8_K_4x4
 #define ggml_quantize_mat_q8_K_4x8_generic ggml_quantize_mat_q8_K_4x8
diff --git a/ggml/src/ggml-cpu/arch/arm/quants.c b/ggml/src/ggml-cpu/arch/arm/quants.c
index bea782f..d106aa0 100644
--- a/ggml/src/ggml-cpu/arch/arm/quants.c
+++ b/ggml/src/ggml-cpu/arch/arm/quants.c
@@ -365,6 +365,84 @@ void ggml_vec_dot_pq2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const vo
     *s = sumf;
 }
 
+#if defined(__aarch64__) && defined(__ARM_FEATURE_DOTPROD)
+// PTQ1_0 x Q8_0 (CIOT). Trit nn of a packed byte is floor(3 * (byte * 3^nn mod 256) / 256), and
+// for any byte v that equals (v >= 86) + (v >= 171). NEON compares return 0 or -1, so a weight
+// is -1 - mask(v >= 86) - mask(v >= 171): one multiply, two compares and two subtracts per 16
+// weights on full vectors, then one SDOT. CIOT_PTQ1=0 selects the generic loop for A/B runs.
+static inline int8x16_t ggml_ciot_ptq1_0_trits(uint8x16_t v) {
+    const int8x16_t ge1 = vreinterpretq_s8_u8(vcgeq_u8(v, vdupq_n_u8(86)));
+    const int8x16_t ge2 = vreinterpretq_s8_u8(vcgeq_u8(v, vdupq_n_u8(171)));
+    return vsubq_s8(vsubq_s8(vdupq_n_s8(-1), ge1), ge2);
+}
+
+void ggml_vec_dot_ptq1_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char * v = getenv("CIOT_PTQ1");
+        enabled = !(v && v[0] == '0');
+    }
+    if (!enabled) {
+        ggml_vec_dot_ptq1_0_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+        return;
+    }
+
+    assert(n % QK_PTQ1_0 == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_ptq1_0 * GGML_RESTRICT x = vx;
+    const block_q8_0   * GGML_RESTRICT y = vy;
+    const int nb = n / QK_PTQ1_0;
+
+    // Bytes 16..23 are processed as a 16-lane vector holding two trit positions at once.
+    static const uint8_t k_pow_1_3[16]  = {1, 1, 1, 1, 1, 1, 1, 1, 3, 3, 3, 3, 3, 3, 3, 3};
+    static const uint8_t k_pow_9_27[16] = {9, 9, 9, 9, 9, 9, 9, 9, 27, 27, 27, 27, 27, 27, 27, 27};
+    static const uint8_t k_pow_qh[8]    = {1, 1, 3, 3, 9, 9, 27, 27};
+    const uint8x16_t pow_1_3  = vld1q_u8(k_pow_1_3);
+    const uint8x16_t pow_9_27 = vld1q_u8(k_pow_9_27);
+    const uint8x8_t  pow_qh   = vld1_u8(k_pow_qh);
+    const int32x4_t  zero     = vdupq_n_s32(0);
+
+    float32x4_t acc = vdupq_n_f32(0.0f);
+
+    for (int i = 0; i < nb; ++i) {
+        const block_q8_0 * GGML_RESTRICT yb = y + 4 * i;
+
+        const uint8x16_t q16  = vld1q_u8(x[i].qs);
+        const uint8x8_t  q8   = vld1_u8(x[i].qs + 16);
+        const uint8x16_t q8x2 = vcombine_u8(q8, q8);
+        uint16_t qh_pair;
+        memcpy(&qh_pair, x[i].qh, sizeof(qh_pair));
+        const uint8x8_t qh = vreinterpret_u8_u16(vdup_n_u16(qh_pair)); // h0 h1 h0 h1 ...
+
+        // values 0..79: bytes 0..15, trit nn is values 16nn..16nn+15
+        int32x4_t a0 = ggml_vdotq_s32(zero, ggml_ciot_ptq1_0_trits(q16), vld1q_s8(yb[0].qs));
+        a0 = ggml_vdotq_s32(a0, ggml_ciot_ptq1_0_trits(vmulq_u8(q16, vdupq_n_u8(3))),  vld1q_s8(yb[0].qs + 16));
+        int32x4_t a1 = ggml_vdotq_s32(zero, ggml_ciot_ptq1_0_trits(vmulq_u8(q16, vdupq_n_u8(9))), vld1q_s8(yb[1].qs));
+        a1 = ggml_vdotq_s32(a1, ggml_ciot_ptq1_0_trits(vmulq_u8(q16, vdupq_n_u8(27))), vld1q_s8(yb[1].qs + 16));
+        int32x4_t a2 = ggml_vdotq_s32(zero, ggml_ciot_ptq1_0_trits(vmulq_u8(q16, vdupq_n_u8(81))), vld1q_s8(yb[2].qs));
+        // values 80..111: bytes 16..23, two trit positions per vector
+        a2 = ggml_vdotq_s32(a2, ggml_ciot_ptq1_0_trits(vmulq_u8(q8x2, pow_1_3)), vld1q_s8(yb[2].qs + 16));
+        int32x4_t a3 = ggml_vdotq_s32(zero, ggml_ciot_ptq1_0_trits(vmulq_u8(q8x2, pow_9_27)), vld1q_s8(yb[3].qs));
