+// CIOT T2P layout for PQ2_0 on AArch64 (repack tag: INTER_SIZE 16, NB_COLS 4, Q8_K activations).
+//
+// Same bits as PQ2_0 (2-bit codes u = w + 1, one fp16 scale per 128 weights), rearranged so NEON
+// decodes them with one AND or shift per 16 weights instead of a table lookup, shift, mask and
+// subtract, and so the decoded vectors are SMMLA operands as-is:
+//   - 4 rows per 128-weight block, grouped in row pairs (0,1) and (2,3), four 16-byte words per pair;
+//   - byte j of word w of pair p holds, in bits 2s..2s+1, row 2p + (j >= 8), weight 8(4w + s) + (j & 7),
+//     so (word >> 2s) & 3 is [row 2p: 8 weights of chunk 4w + s | row 2p+1: same chunk];
+//   - the +1 offset is removed once per block with the activation sums Q8_K already carries.
+// A block of 4 rows is 136 bytes, exactly 4 * sizeof(block_pq2_0), so the repack is in place.
+#include <arm_neon.h>
+#include <cstdlib>
+#include <vector>
+
+#define GGML_CIOT_T2 1
+
+struct block_pq2_0_t2x4 {
+    ggml_half d[4];
+    uint8_t   qs[2][4][16]; // [pair][word][byte]
+};
+
+// Slots 1 and 2 are masked in place (values scaled by 4 and 16) and accumulate separately;
+// one recombine per block replaces a shift per vector.
+static inline int8x16_t ggml_ciot_slot0(uint8x16_t v) { return vreinterpretq_s8_u8(vandq_u8(v, vdupq_n_u8(0x03))); }
+static inline int8x16_t ggml_ciot_slot1(uint8x16_t v) { return vreinterpretq_s8_u8(vandq_u8(v, vdupq_n_u8(0x0C))); }
+static inline int8x16_t ggml_ciot_slot2(uint8x16_t v) { return vreinterpretq_s8_u8(vandq_u8(v, vdupq_n_u8(0x30))); }
+static inline int8x16_t ggml_ciot_slot3(uint8x16_t v) { return vreinterpretq_s8_u8(vshrq_n_u8(v, 6)); }
+static_assert(sizeof(block_pq2_0_t2x4) == 4 * sizeof(block_pq2_0), "t2x4 must repack PQ2_0 in place");
+
+static bool ggml_ciot_t2_enabled() {
+    static const bool enabled = [] {
+        const char * v = getenv("CIOT_T2");
+        return !(v && v[0] == '0');
+    }();
+    return enabled;
+}
+
+// s[0..3] = dot(row r, y) for the 4 rows in x. n is a multiple of QK_K. SDOT against a chunk's
+// 8 activations duplicated into both halves puts row 2p in lanes 0-1 and row 2p+1 in lanes 2-3.
+static void ggml_ciot_gemv_t2x4_q8_K(int n, float * GGML_RESTRICT s, const block_pq2_0_t2x4 * GGML_RESTRICT x, const block_q8_K * GGML_RESTRICT y) {
+    const int nb = n / QK_PQ2_0;
+
+    float32x4_t acc = vdupq_n_f32(0.0f);
+
+    for (int i = 0; i < nb; ++i) {
+        const block_q8_K * GGML_RESTRICT yb = y + (i >> 1);
+        const int8_t * GGML_RESTRICT q8 = yb->qs + 128 * (i & 1);
+        const int32_t ysum = vaddlvq_s16(vld1q_s16(yb->bsums + 8 * (i & 1)));
+
+        // one accumulator per (pair, slot): 8 independent SDOT chains
