+// The 1..3 src1 rows left after the 4-row gemm tiles. Default: one gemv per row. ds is the dst row stride in floats.
+template <typename BLOC_TYPE, int64_t INTER_SIZE, int64_t NB_COLS, ggml_type PARAM_TYPE>
+void gemv_rows(int n, float * s, size_t ds, size_t bs, const void * vx, const char * vy, size_t vy_stride, int nrows, int nc) {
+    for (int r = 0; r < nrows; r++) {
+        gemv<BLOC_TYPE, INTER_SIZE, NB_COLS, PARAM_TYPE>(n, s + r * ds, bs, vx, vy + r * vy_stride, 1, nc);
+    }
+}
+
+#if defined(GGML_PQ2_0_4X16) && defined(__ARM_FEATURE_MATMUL_INT8)
+// 2 or 3 left rows (short speculative verify batches): pad to one Q8_Kx4 group so the weights are read once, not once per row.
+template <> void gemv_rows<block_pq2_0, 16, 4, GGML_TYPE_Q8_K>(int n, float * s, size_t ds, size_t bs, const void * vx, const char * vy, size_t vy_stride, int nrows, int nc) {
+    if (nrows == 1) {
+        gemv<block_pq2_0, 16, 4, GGML_TYPE_Q8_K>(n, s, bs, vx, vy, 1, nc);
+        return;
+    }
+    const int nbk = n / QK_K;
+    thread_local std::vector<block_q8_Kx4> y4;
+    thread_local std::vector<float>        out;
+    y4.resize(nbk);
+    out.resize((size_t) 4 * nc);
+    for (int b = 0; b < nbk; ++b) {
+        block_q8_Kx4 & dst = y4[b];
+        for (int r = 0; r < 4; ++r) {
+            if (r < nrows) {
+                const block_q8_K * src = (const block_q8_K *) (vy + r * vy_stride) + b;
+                dst.d[r] = src->d;
+                for (int c = 0; c < QK_K / 8; ++c) {
+                    memcpy(dst.qs + 32 * c + 8 * r, src->qs + 8 * c, 8);
+                }
+            } else {
+                dst.d[r] = 0.0f;
+                for (int c = 0; c < QK_K / 8; ++c) {
+                    memset(dst.qs + 32 * c + 8 * r, 0, 8);
+                }
+            }
+        }
+    }
+    ggml_gemm_pq2_0_4x16_q8_K_neon(n, out.data(), (size_t) nc, vx, y4.data(), 4, nc);
+    for (int r = 0; r < nrows; ++r) {
+        memcpy(s + r * ds, out.data() + (size_t) r * nc, (size_t) nc * sizeof(float));
+    }
+}
+#endif
